{
  "name": "@yaya-digital/sanity-plugin-ga-dashboard",
  "version": "1.1.0",
  "description": "GA4 dashboard plugin for Sanity Studio with BFF-mediated OAuth",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "recharts": "^2.5.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@sanity/icons": "^3",
    "@sanity/ui": "^3",
    "@vercel/kv": "^3",
    "react": "^18 || ^19",
    "sanity": "^3 || ^5"
  },
  "peerDependenciesMeta": {
    "@vercel/kv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sanity/icons": "^3.0.0",
    "@sanity/ui": "^3.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@vercel/kv": "^3.0.0",
    "sanity": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "6.0.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
